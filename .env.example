# TypeScript entry points do not automatically load .env. Export variables securely.
# Never record shell environment dumps or put real keys/bundles/provider tokens in history.
# BASE_RPC_URL: e2e fork source, live-config/preflight, subgraph checks, and redemption/server.ts.
# For manual redemption this is the target chain RPC, not necessarily the fork source.
# Facilitator and resource server instead read RPC_URL (see packages/README.md).
# Base fork tests skip when this is unset.
BASE_RPC_URL=

# Receipt #1 redemption preimage bundle. Bundle-dependent tests skip when either is unset.
# Solidity receipt compatibility tests only; not needed for the connected demo.
# Supply securely; never commit or display the real values.
RECEIPT_1_RAW_PURCHASE_REF=
RECEIPT_1_PURCHASE_REF_NONCE=

# Optional. Receipt store the deploy scripts target.
# Defaults to the Base mainnet NotaReceiptStore.
NOTA_RECEIPT_STORE=

# Comma-separated settlement modules EntitlementRedemption accepts as payers, beyond the store
# itself. Deploy NotaX402Settlement first and list it here, or its settlements are unredeemable.
ENTITLEMENT_ACCEPTED_CONSUMERS=

# Redemption backend (packages/resource-server/src/redemption/server.ts).
# Mock authenticates wallet control, NOT World ID / AgentBook.
# Required by both resource-server and redemption-server: same absolute file path.
# Contains preimage bundles. Use a private persistent directory; never commit the file.
# Example: /absolute/path/to/private-data/issued-orders.json
QUOTE_STORE_PATH=
# No automatic fallback. NODE_ENV=production refuses mock mode.
AGENT_AUTH_MODE=
ENTITLEMENT_REDEMPTION=
# Trusted adapter emitters (comma-separated). Each must also be accepted by the contract.
REDEMPTION_ADAPTERS=
# Read by resource-server/src/server.ts (quote signing), redemption/server.ts (submission),
# and e2e/src/live-config.ts (live demo/preflight). Never put it in history or commit it.
SELLER_PRIVATE_KEY=
REDEMPTION_PORT=4022
REDEMPTION_BASE_URL=http://127.0.0.1:4022
REDEMPTION_CONFIRMATIONS=2

# Opt-in connected demo on Base mainnet: npm run demo:connected -- --live
# CURRENT SNAPSHOT: both manifests have publicDemo; the CLI blocks another paid run.
# Preserve that guard/evidence. Use --story without --live for repeatable fork recordings.
# Also requires a TTY confirmation. Scripts do not automatically load this file.
# SELLER_PRIVATE_KEY above pays listing/redemption gas. Buyer must hold real Base USDC.
BUYER_PRIVATE_KEY=
# e2e/src/live-config.ts only. Optional: defaults to SELLER_PRIVATE_KEY.
# Pays settlement gas, never the buyer key. NOT used by standalone facilitator/server.ts,
# which requires FACILITATOR_PRIVATE_KEY instead.
RELAYER_PRIVATE_KEY=
# Explicit amount, > 0 and <= 10 USDC, at most six decimals. Example: 0.10
LIVE_DEMO_USDC_AMOUNT=
# New absolute directory below this repo's ignored private-data directory.
# Retained on failure/success; never reuse a previous run's directory blindly.
LIVE_DEMO_STATE_DIR=

# Manual service variables are separate from the connected fixture (no values supplied here):
# packages/facilitator/src/server.ts reads RPC_URL, CHAIN_ID, FACILITATOR_PORT,
# FACILITATOR_PRIVATE_KEY and NOTA_X402_ADAPTER.
# packages/resource-server/src/server.ts reads RPC_URL, CHAIN_ID, RESOURCE_PORT,
# RESOURCE_BASE_URL, FACILITATOR_URL, LISTING_ID, FROM_BLOCK, NOTA_X402_ADAPTER,
# SETTLEMENT_TOKEN, PURCHASE_REF_REGISTRY, NOTA_RECEIPT_STORE, SELLER_PRIVATE_KEY,
# and QUOTE_STORE_PATH. Manual commands do not deploy, authorize or fund contracts.
